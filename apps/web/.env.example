# Copy to .env.local and fill in from `pnpm supabase status` (local) or the Supabase dashboard.
# Only public values belong here. Never put the service-role / secret key in apps/web.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Debug tools (the /search test page). Leave false anywhere but your own machine.
DEBUG_TOOLS=false

# Server-only. Service-role key, used only to store tracklists (set_album_tracks). Local value:
# SECRET_KEY from `pnpm supabase status`. Never prefix with NEXT_PUBLIC_ and never commit a real one.
SUPABASE_SECRET_KEY=
